# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Caches and temporary test data
.cache/
test_cache/
datasets/distillation_cache/
*.log
*.tmp
*.zip

# Virtual Environments
.venv/
venv/
env/
ENV/

# IDE and Editor Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
.agents/

# Large dataset raw zips (keep datasets/ structure, ignore raw archives)
datasets/**/*.zip
datasets/**/*.tar.gz

# Large legacy files exceeding GitHub 100MB limit
archive/
weights/checkpoints/StereoINR_official.pth
external/**/*.pth
external/**/*.pth.tar

# Unity / Sentis temporary meta files if opened in editor
*.pidb
*.booproj

# Local scratch and debug scripts
scratch/
demo_results/
deployment/kaggle_dual_t4_training/kaggle_live_output/
logs/kaggle_status/
weights/kaggle_dual_t4/v11_output/
